# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase REST API settings used only by Vercel serverless API routes.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"

# Zapier should send this as: Authorization: Bearer YOUR_RANDOM_SECRET
LEAD_WEBHOOK_SECRET="YOUR_RANDOM_SECRET"

# Optional: used by /api/leads and the manager dashboard panel.
LEADS_DASHBOARD_TOKEN="YOUR_DASHBOARD_TOKEN"
VITE_LEADS_DASHBOARD_TOKEN="YOUR_DASHBOARD_TOKEN"

# Optional: Kakao Alimtalk relay endpoint from your Kakao bizmessage provider,
# Zapier, Make, or an internal notification service.
LEAD_NOTIFICATION_WEBHOOK_URL="https://example.com/kakao-alimtalk-relay"
LEAD_MANAGER_PHONE="01000000000"
KAKAO_ALIMTALK_TEMPLATE_CODE="cloud9_new_lead"

# Optional: send an SMS notification to the manager when a lead is saved.
# Uses the same Solapi/Nurigo credentials below.
LEAD_MANAGER_SMS_ENABLED="false"
LEAD_MANAGER_NOTIFICATION_TEXT="[Meta Lead - Care Consulting] 주간보호센터/방문요양 컨설팅 상담 신청이 접수되었습니다."

# Optional: customer auto-reply SMS after a lead is saved.
# Set CUSTOMER_AUTO_REPLY_ENABLED to "true" only after the SMS provider is ready.
CUSTOMER_AUTO_REPLY_ENABLED="false"
CUSTOMER_AUTO_REPLY_TEXT="주간보호센터/방문요양 컨설팅 상담 신청이 접수되었습니다. 클라우드나인메디케어 담당자가 확인 후 연락드리겠습니다."

# Option A: send customer auto-reply through a custom relay/Zapier/Make webhook.
CUSTOMER_AUTO_REPLY_WEBHOOK_URL=""
CUSTOMER_AUTO_REPLY_CHANNEL="sms"

# Option B: send customer auto-reply directly through Solapi/Nurigo SMS API.
SOLAPI_API_KEY=""
SOLAPI_API_SECRET=""
SOLAPI_SENDER_PHONE="01000000000"
